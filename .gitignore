# Local deploy folder: compiled binary + game data for playing/testing.
# Everything in it stays out of git.
/bin/
/build/

# Build scripts write release archives here. They are published separately from the repository.
/release/

# Build outputs at the repo root (root only; do not match cmd/max-go/)
/max-go
/max-go.exe
/max-go-test
/max-go-test.exe

# Agent working files never belong in the repo (tracking docs live outside it).
.claude/
.codex/
.agents/

# Per-user runtime files (created next to the binary)
settings.json
settings.ini
saves/
screenshots/
shots/
max-go.log

# Captured frames from `-menu`/`-screenshot` verification runs
# (contain copyrighted game art)
/shots/


# Original game data files, copyrighted, never commit them no matter
# where they are copied in the repo (git on Windows matches these
# case-insensitively; lowercase variants listed for Linux checkouts).
*.PY
*.PS1
# Windows matches these patterns case-insensitively, so they also ignore lowercase .py and .ps1 files.
# The Linux tarball packer remains tracked because the release build uses it.
!/pack-linux-tar.py
*.RES
*.WRL
*.PAL
*.FON
*.MSC
*.WAV
*.FLC
*.MVE
*.CAM
*.SCE
*.TRA
*.MPS
*.DMO
*.RST
*.386
*.res
*.wrl
*.pal
*.fon
*.msc
*.wav
*.flc
*.mve
*.cam
*.sce
*.tra
*.mps
*.dmo
*.rst
